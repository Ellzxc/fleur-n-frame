{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "fleur-n-frame/client",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "bindings": [
        { "type": "service", "service": "server", "format": "url", "env": "API_URL" }
      ]
    },
    "server": {
      "root": "fleur-n-frame/server",
      "framework": "express",
      "buildCommand": "npm install",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
